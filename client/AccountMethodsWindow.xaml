<Window x:Class="CodeExplainer.AccountMethodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account"
        Width="660"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101826" />
        <SolidColorBrush x:Key="PanelBrush" Color="#182337" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#111A2B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F8FB" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B7C0D2" />
        <SolidColorBrush x:Key="FieldBrush" Color="#F5F8FF" />
        <SolidColorBrush x:Key="FieldTextBrush" Color="#162132" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#8AA7D6" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#79B4FF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#08111E" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#22314B" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#385273" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5CCB96" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFB6A8" />

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border Margin="24"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#2D4565"
            BorderThickness="1"
            CornerRadius="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            Background="#20304A"
                            BorderBrush="#36516F"
                            BorderThickness="1"
                            CornerRadius="17">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="sd" />
                    </Border>

                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="simpleDocs account" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Text="Link more sign-in methods" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Content="×"
                        Style="{StaticResource TitleButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,20,0,0">
                <TextBlock x:Name="AccountNameText"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Current account" />
                <TextBlock x:Name="AccountEmailText"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           Text="Signed-in identity" />
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="16"
                    Background="{StaticResource PanelSecondaryBrush}"
                    BorderBrush="#2B405D"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Linked methods" />
                    <ListBox x:Name="LinkedMethodsList"
                             Margin="0,10,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Grid x:Name="FormContentGrid"
                  Grid.Row="3"
                  Margin="0,20,0,0">
                <TabControl x:Name="ProviderTabs"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Google">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Link Google" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           Text="Add a Google sign-in method to this same account without creating a second identity." />
                                <Button Margin="0,20,0,0"
                                        HorizontalAlignment="Left"
                                        Click="GoogleLinkButton_Click"
                                        Content="Link Google"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Redeem code">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Link a redeem code" />

                                <TextBlock Margin="0,16,0,6"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Redeem code" />
                                <TextBox x:Name="RedeemCodeTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}" />

                                <Button Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Click="RedeemCodeLinkButton_Click"
                                        Content="Link redeem code"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Email/password">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Link email and password" />

                                <TextBlock Margin="0,16,0,6"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Display name (optional)" />
                                <TextBox x:Name="EmailDisplayNameTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}" />

                                <TextBlock Margin="0,14,0,6"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Email" />
                                <TextBox x:Name="EmailTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}" />

                                <TextBlock Margin="0,14,0,6"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Password" />
                                <PasswordBox x:Name="PasswordTextBox"
                                             Style="{StaticResource FieldPasswordStyle}" />

                                <Button Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Click="EmailLinkButton_Click"
                                        Content="Link email/password"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="4"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="BusyText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="ErrorText"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Width="116"
                        Click="CancelButton_Click"
                        Content="Close"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
