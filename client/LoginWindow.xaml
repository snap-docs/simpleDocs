<Window x:Class="CodeExplainer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In"
        Width="500"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush"           Color="#101826" />
        <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#F7F8FB" />
        <SolidColorBrush x:Key="TextMutedBrush"        Color="#8896B2" />
        <SolidColorBrush x:Key="FieldBgBrush"          Color="#1A2A40" />
        <SolidColorBrush x:Key="FieldBorderBrush"      Color="#2D4565" />
        <SolidColorBrush x:Key="DividerBrush"          Color="#1E2E45" />
        <SolidColorBrush x:Key="AccentBrush"           Color="#5CCB96" />
        <SolidColorBrush x:Key="ErrorBrush"            Color="#FFB6A8" />
        <SolidColorBrush x:Key="LinkBrush"             Color="#79B4FF" />

        <!-- Close button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="30" />
            <Setter Property="Height"          Value="30" />
            <Setter Property="Foreground"      Value="#8896B2" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="18" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#1E2D42" />
                                <Setter Property="Foreground"  Value="#F7F8FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google button — white, branded -->
        <Style x:Key="GoogleButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#FFFFFF" />
            <Setter Property="BorderBrush"     Value="#DADCE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height"          Value="44" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"  Value="#F8F9FA" />
                                <Setter Property="BorderBrush" Value="#BABCBF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background"  Value="#F1F3F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB" />
            <Setter Property="Foreground"      Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="FontWeight"      Value="SemiBold" />
            <Setter Property="Height"          Value="38" />
            <Setter Property="Padding"         Value="22,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Link-style button -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{StaticResource LinkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize"        Value="12" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text field -->
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource FieldBgBrush}" />
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush"      Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="12,9" />
            <Setter Property="FontSize"        Value="13" />
        </Style>

        <!-- Password field -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="{StaticResource FieldBgBrush}" />
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush"      Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="12,9" />
            <Setter Property="FontSize"        Value="13" />
        </Style>

        <!-- Cancel / secondary button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#1A2A40" />
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}" />
            <Setter Property="BorderBrush"     Value="#2D4565" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Height"          Value="36" />
            <Setter Property="Padding"         Value="20,0" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22314B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#243550"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" Opacity="0.55"
                              ShadowDepth="6" Direction="270" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="#1E2D42"
                            BorderBrush="#2D4565"
                            BorderThickness="1"
                            CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#79B4FF"
                                   Text="sd" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="simpleDocs" />
                </StackPanel>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Content="×"
                        Style="{StaticResource CloseButtonStyle}" />
            </Grid>

            <!-- Heading -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="Sign in to simpleDocs" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="13"
                           Text="AI assistant that works in any app on your screen" />
            </StackPanel>

            <!-- Form content -->
            <StackPanel x:Name="FormContentGrid"
                        Grid.Row="2"
                        Margin="0,22,0,0">

                <!-- Google button -->
                <Button Click="GoogleContinueButton_Click"
                        Style="{StaticResource GoogleButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="G"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#4285F4"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="Continue with Google"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#3C4043"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Divider -->
                <Grid Margin="0,18,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="0" Height="1"
                               Fill="{StaticResource DividerBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               Text="or" />
                    <Rectangle Grid.Column="2" Height="1"
                               Fill="{StaticResource DividerBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Sign-in form -->
                <StackPanel x:Name="SignInPanel">
                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,0,0,5" Text="Email" />
                    <TextBox x:Name="EmailSignInEmailTextBox"
                             Style="{StaticResource FieldStyle}"
                             PreviewKeyDown="SignInEmailField_KeyDown" />

                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,12,0,5" Text="Password" />
                    <PasswordBox x:Name="EmailSignInPasswordBox"
                                 Style="{StaticResource PasswordStyle}"
                                 PreviewKeyDown="SignInPasswordField_KeyDown" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="EmailSignInButton_Click"
                                Content="Sign in"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="2"
                                Click="ShowRegisterPanel_Click"
                                Content="Create an account →"
                                Style="{StaticResource LinkButtonStyle}" />
                    </Grid>
                </StackPanel>

                <!-- Register form (hidden by default) -->
                <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,0,0,5" Text="Display name (optional)" />
                    <TextBox x:Name="EmailRegisterDisplayNameTextBox"
                             Style="{StaticResource FieldStyle}" />

                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,12,0,5" Text="Email" />
                    <TextBox x:Name="EmailRegisterEmailTextBox"
                             Style="{StaticResource FieldStyle}"
                             PreviewKeyDown="RegisterEmailField_KeyDown" />

                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,12,0,5" Text="Password" />
                    <PasswordBox x:Name="EmailRegisterPasswordBox"
                                 Style="{StaticResource PasswordStyle}"
                                 PreviewKeyDown="RegisterPasswordField_KeyDown" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Click="EmailRegisterButton_Click"
                                Content="Create account"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Grid.Column="2"
                                Click="ShowSignInPanel_Click"
                                Content="← Back to sign in"
                                Style="{StaticResource LinkButtonStyle}" />
                    </Grid>
                </StackPanel>

                <!-- Redeem code expander -->
                <StackPanel Margin="0,22,0,0">
                    <Button x:Name="RedeemToggleButton"
                            Click="RedeemCodeToggle_Click"
                            Content="Have a support code?"
                            HorizontalAlignment="Left"
                            Style="{StaticResource LinkButtonStyle}" />

                    <StackPanel x:Name="RedeemCodePanel"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,0,5" Text="Support code" />
                        <TextBox x:Name="RedeemCodeTextBox"
                                 Style="{StaticResource FieldStyle}"
                                 PreviewKeyDown="RedeemCodeField_KeyDown" />
                        <Button Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Click="RedeemCodeContinueButton_Click"
                                Content="Continue with code"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="ErrorText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
