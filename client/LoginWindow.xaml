<Window x:Class="CodeExplainer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In"
        Width="660"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101826" />
        <SolidColorBrush x:Key="PanelBrush" Color="#182337" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#111A2B" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F7F8FB" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#B7C0D2" />
        <SolidColorBrush x:Key="FieldBrush" Color="#F5F8FF" />
        <SolidColorBrush x:Key="FieldTextBrush" Color="#162132" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#8AA7D6" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#79B4FF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#08111E" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#22314B" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#385273" />
        <SolidColorBrush x:Key="AccentBrush" Color="#5CCB96" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FFB6A8" />

        <Style x:Key="TitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FieldTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Border Margin="24"
            Background="{StaticResource WindowBrush}"
            BorderBrush="#2D4565"
            BorderThickness="1"
            CornerRadius="18">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            Background="#20304A"
                            BorderBrush="#36516F"
                            BorderThickness="1"
                            CornerRadius="17">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="sd" />
                    </Border>

                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="simpleDocs" />
                        <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Text="Google-first sign-in" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="CloseButton_Click"
                        Content="×"
                        Style="{StaticResource TitleButtonStyle}" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,20,0,0">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Text="Sign in to simpleDocs" />
                <TextBlock Margin="0,10,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           Text="Continue with Google, or use email/password or a support-provided redeem code if your team asked you to." />
            </StackPanel>

            <Grid x:Name="FormContentGrid"
                  Grid.Row="2"
                  Margin="0,20,0,0">
                <TabControl x:Name="ProviderTabs"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Google">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Continue with Google" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           Text="simpleDocs opens your browser, completes the Google sign-in flow securely through the backend, and returns you to the desktop app." />

                                <Border Margin="0,20,0,0"
                                        Padding="16"
                                        Background="{StaticResource PanelSecondaryBrush}"
                                        BorderBrush="#2B405D"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="What happens next" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="13"
                                                   Text="1. The app opens your default browser." />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="13"
                                                   Text="2. Google signs you in and redirects back to this device." />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="13"
                                                   Text="3. simpleDocs creates the same shared session model used by every provider." />
                                    </StackPanel>
                                </Border>

                                <Button Margin="0,20,0,0"
                                        HorizontalAlignment="Left"
                                        Click="GoogleContinueButton_Click"
                                        Content="Continue with Google"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <TabItem Header="Email/password">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TabControl x:Name="EmailModeTabs"
                                        Background="Transparent"
                                        BorderThickness="0">
                                <TabItem Header="Sign in">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="Sign in with email and password" />

                                        <TextBlock Margin="0,16,0,6"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Text="Email" />
                                        <TextBox x:Name="EmailSignInEmailTextBox"
                                                 Style="{StaticResource FieldTextBoxStyle}" />

                                        <TextBlock Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Text="Password" />
                                        <PasswordBox x:Name="EmailSignInPasswordBox"
                                                     Style="{StaticResource FieldPasswordStyle}" />

                                        <Button Margin="0,18,0,0"
                                                HorizontalAlignment="Left"
                                                Click="EmailSignInButton_Click"
                                                Content="Sign in"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="Create account">
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Text="Create an email/password sign-in" />

                                        <TextBlock Margin="0,16,0,6"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Text="Display name (optional)" />
                                        <TextBox x:Name="EmailRegisterDisplayNameTextBox"
                                                 Style="{StaticResource FieldTextBoxStyle}" />

                                        <TextBlock Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Text="Email" />
                                        <TextBox x:Name="EmailRegisterEmailTextBox"
                                                 Style="{StaticResource FieldTextBoxStyle}" />

                                        <TextBlock Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Text="Password" />
                                        <PasswordBox x:Name="EmailRegisterPasswordBox"
                                                     Style="{StaticResource FieldPasswordStyle}" />

                                        <Button Margin="0,18,0,0"
                                                HorizontalAlignment="Left"
                                                Click="EmailRegisterButton_Click"
                                                Content="Create account"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </TabItem>

                    <TabItem Header="Redeem code (legacy)">
                        <Border Margin="0,14,0,0"
                                Padding="18"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="#2B405D"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Continue with a redeem code" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="13"
                                           Text="Use this only if your team gave you a redeem code for a legacy or support-managed account." />

                                <TextBlock Margin="0,18,0,6"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12"
                                           Text="Redeem code" />
                                <TextBox x:Name="RedeemCodeTextBox"
                                         Style="{StaticResource FieldTextBoxStyle}" />

                                <Button Margin="0,18,0,0"
                                        HorizontalAlignment="Left"
                                        Click="RedeemCodeContinueButton_Click"
                                        Content="Continue with redeem code"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="3"
                  Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="BusyText"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="ErrorText"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Width="116"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Window>
